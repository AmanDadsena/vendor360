# ---------------------------------------------------------------- Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Lockfiles are committed for the app (a deployable) and omitted for the
# packages (libraries), which is the convention Dart recommends.
packages/*/pubspec.lock

# Golden-test failure output. The accepted goldens under test/golden/ are
# committed; these are only the diffs from a failing run.
**/failures/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Generated by `python seed.py --reset`, ~47MB and fully reproducible.
# Committing it would put a binary blob in every clone for no benefit.
backend/*.db
backend/*.db-journal

# ------------------------------------------------------------------ misc
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.log
